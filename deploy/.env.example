# Copy to deploy/.env and fill values

# App URL (used in subscription/integrations actions)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=

# Google AI (Gemini)
GOOGLE_API_KEY=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=

# Firecrawl
FIRECRAWL_API_KEY=

# Dodo Payments
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_IS_LIVE=false
